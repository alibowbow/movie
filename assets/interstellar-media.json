  "dialogue": {
    "url": "https://res.cloudinary.com/o0mjeken/video/upload/v1789993665/movie/interstellar/v2-dialogue-algenib.mp3",
    "provider": "Gemini Voice Studio",
    "cues": [
      {
        "index": 1,
        "speaker": "TARS",
        "voice": "Schedar",
        "text": "All systems are green.",
        "start": 5.5,
        "end": 7.896,
        "tempo": 1,
        "offset": 0.0,
        "duration": 2.396
      },
      {
        "index": 2,
        "speaker": "COOPER",
        "voice": "Algenib",
        "text": "Then let's see what's out there.",
        "start": 10.5,
        "end": 12.695458,
        "tempo": 1,
        "offset": 2.496,
        "duration": 2.195458
      },
      {
        "index": 3,
        "speaker": "COOPER",
        "voice": "Algenib",
        "text": "There it is. Hold this heading.",
        "start": 23.5,
        "end": 24.888542,
        "tempo": 1,
        "offset": 4.791458,
        "duration": 1.388542
      },
      {
        "index": 4,
        "speaker": "BRAND",
        "voice": "Leda",
        "text": "Everything looks different on the other side.",
        "start": 32.5,
        "end": 35.744,
        "tempo": 1,
        "offset": 6.28,
        "duration": 3.244
      },
      {
        "index": 5,
        "speaker": "COOPER",
        "voice": "Algenib",
        "text": "Stay with me. We're almost through.",
        "start": 40.0,
        "end": 42.149708,
        "tempo": 1,
        "offset": 9.624,
        "duration": 2.149708
      },
      {
        "index": 6,
        "speaker": "COOPER",
        "voice": "Algenib",
        "text": "We're through. Check our position.",
        "start": 47.0,
        "end": 48.621375,
        "tempo": 1,
        "offset": 11.873708,
        "duration": 1.621375
      },
      {
        "index": 7,
        "speaker": "ROMILLY",
        "voice": "Charon",
        "text": "Gargantua. And that's Miller's world below us.",
        "start": 51.7,
        "end": 55.367,
        "tempo": 1,
        "offset": 13.595083,
        "duration": 3.667
      },
      {
        "index": 8,
        "speaker": "ROMILLY",
        "voice": "Charon",
        "text": "I'll hold orbit. Take the Ranger down.",
        "start": 58.0,
        "end": 60.497,
        "tempo": 1,
        "offset": 17.362083,
        "duration": 2.497
      },
      {
        "index": 9,
        "speaker": "COOPER",
        "voice": "Algenib",
        "text": "Looks shallow. I'm setting her down.",
        "start": 67.0,
        "end": 69.6405,
        "tempo": 1,
        "offset": 19.959083,
        "duration": 2.6405
      },
      {
        "index": 10,
        "speaker": "BRAND",
        "voice": "Leda",
        "text": "Cooper... that ridge is getting closer.",
        "start": 76.0,
        "end": 78.815,
        "tempo": 1,
        "offset": 22.699583,
        "duration": 2.815
      },
      {
        "index": 11,
        "speaker": "COOPER",
        "voice": "Algenib",
        "text": "It's a wave. Everyone back to the ship.",
        "start": 82.0,
        "end": 84.754125,
        "tempo": 1,
        "offset": 25.614583,
        "duration": 2.754125
      },
      {
        "index": 12,
        "speaker": "COOPER",
        "voice": "Algenib",
        "text": "Come on. We need to move.",
        "start": 92.0,
        "end": 94.3,
        "tempo": 1,
        "offset": 28.468708,
        "duration": 2.3
      },
      {
        "index": 13,
        "speaker": "COOPER",
        "voice": "Algenib",
        "text": "Climbing. Keep your eyes on that crest.",
        "start": 100.0,
        "end": 103.169875,
        "tempo": 1,
        "offset": 30.868708,
        "duration": 3.169875
      },
      {
        "index": 14,
        "speaker": "BRAND",
        "voice": "Leda",
        "text": "She's breaking apart. We have to reach her.",
        "start": 110.5,
        "end": 113.022,
        "tempo": 1,
        "offset": 34.138583,
        "duration": 2.522
      },
      {
        "index": 15,
        "speaker": "COOPER",
        "voice": "Algenib",
        "text": "Match her rotation. Keep us on the axis.",
        "start": 118.5,
        "end": 121.014958,
        "tempo": 1,
        "offset": 36.760583,
        "duration": 2.514958
      },
      {
        "index": 16,
        "speaker": "TARS",
        "voice": "Schedar",
        "text": "Rotation matched. Closing the gap.",
        "start": 130.0,
        "end": 132.731,
        "tempo": 1.216,
        "offset": 39.375542,
        "duration": 2.731
      },
      {
        "index": 17,
        "speaker": "COOPER",
        "voice": "Algenib",
        "text": "Easy... hold it there.",
        "start": 137.0,
        "end": 140.528125,
        "tempo": 1,
        "offset": 42.206542,
        "duration": 3.528125
      },
      {
        "index": 18,
        "speaker": "COOPER",
        "voice": "Algenib",
        "text": "We're locked. Bring the engines online.",
        "start": 142.0,
        "end": 144.591875,
        "tempo": 1,
        "offset": 45.834667,
        "duration": 2.591875
      },
      {
        "index": 19,
        "speaker": "COOPER",
        "voice": "Algenib",
        "text": "We can use the gravity to reach the next world.",
        "start": 149.0,
        "end": 151.700208,
        "tempo": 1,
        "offset": 48.526542,
        "duration": 2.700208
      },
      {
        "index": 20,
        "speaker": "TARS",
        "voice": "Schedar",
        "text": "Not with this much weight.",
        "start": 158.0,
        "end": 160.202,
        "tempo": 1,
        "offset": 51.32675,
        "duration": 2.202
      },
      {
        "index": 21,
        "speaker": "COOPER",
        "voice": "Algenib",
        "text": "I'm detaching. Keep the Endurance on course.",
        "start": 169.0,
        "end": 171.64325,
        "tempo": 1,
        "offset": 53.62875,
        "duration": 2.64325
      },
      {
        "index": 22,
        "speaker": "BRAND",
        "voice": "Leda",
        "text": "Cooper, what are you doing?",
        "start": 173.0,
        "end": 174.968,
        "tempo": 1,
        "offset": 56.372,
        "duration": 1.968
      },
      {
        "index": 23,
        "speaker": "COOPER",
        "voice": "Algenib",
        "text": "Making sure you get there.",
        "start": 177.0,
        "end": 178.760875,
        "tempo": 1,
        "offset": 58.44,
        "duration": 1.760875
      },
      {
        "index": 24,
        "speaker": "COOPER",
        "voice": "Algenib",
        "text": "This is her room. But every moment is here.",
        "start": 191.0,
        "end": 195.540208,
        "tempo": 1,
        "offset": 60.300875,
        "duration": 4.540208
      },
      {
        "index": 25,
        "speaker": "COOPER",
        "voice": "Algenib",
        "text": "She can't hear me. I have to show her.",
        "start": 200.0,
        "end": 204.4,
        "tempo": 1,
        "offset": 64.941083,
        "duration": 4.4
      },
      {
        "index": 26,
        "speaker": "COOPER",
        "voice": "Algenib",
        "text": "The watch. She still has it.",
        "start": 211.0,
        "end": 214.200042,
        "tempo": 1,
        "offset": 69.441083,
        "duration": 3.200042
      },
      {
        "index": 27,
        "speaker": "COOPER",
        "voice": "Algenib",
        "text": "Look at the second hand, Murph. Just look.",
        "start": 218.0,
        "end": 222.370958,
        "tempo": 1,
        "offset": 72.741125,
        "duration": 4.370958
      }
    ],
    "format": "timed-audio-sprite",
    "bytes": 927692
  },
